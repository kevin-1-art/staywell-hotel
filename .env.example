POSTGRES_DB=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://hotel:replace-with-a-long-random-password@db:5432/hotel
APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-bytes
SEED_USER_PASSWORD=replace-with-a-unique-16-character-password
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=true
PUBLIC_DOMAIN=hotel.example.com
TRUSTED_HOSTS=["hotel.example.com"]
CORS_ORIGINS=["https://hotel.example.com"]